@model DemoMVC.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<h1>Quên mật khẩu</h1>
<p>Nhập email đã đăng ký. Nếu tài khoản hợp lệ, hướng dẫn đặt lại mật khẩu sẽ được gửi qua email.</p>
<form asp-action="ForgotPassword" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Gửi hướng dẫn</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
