@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container">
    <h1>Xóa sinh viên</h1>
    <p>Bạn có chắc chắn muốn xóa sinh viên này không?</p>

    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MaSinhVien)</dt>
        <dd class="col-sm-9">@Model.MaSinhVien</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HoTen)</dt>
        <dd class="col-sm-9">@Model.HoTen</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Khoa)</dt>
        <dd class="col-sm-9">@Model.Khoa.TenKhoa (@Model.MaKhoa)</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.MaSinhVien" method="post">
        <input type="hidden" name="id" value="@Model.MaSinhVien" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>
