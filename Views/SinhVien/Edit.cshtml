
@model DemoMVC.Models.SinhVien

<h1>Sửa thông tin sinh viên</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="HoTen" class="form-label">Họ tên</label>
        <input asp-for="HoTen" class="form-control" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tuoi" class="form-label">Tuổi</label>
        <input asp-for="Tuoi" type="number" class="form-control" />
        <span asp-validation-for="Tuoi" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaKhoa" class="form-label">Khoa</label>
        <select asp-for="MaKhoa" asp-items="ViewBag.MaKhoa" class="form-select">
            <option value="">-- Chọn khoa --</option>
        </select>
        <span asp-validation-for="MaKhoa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
