@model DemoMVC.ViewModels.SinhVienEditViewModel

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="container">
    <h1>Sửa sinh viên</h1>
    <p>Mã sinh viên được tạo tự động và không thay đổi khi cập nhật thông tin.</p>

    <form asp-action="Edit" asp-route-id="@Model.MaSinhVien" method="post">
        <input asp-for="MaSinhVien" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Mã sinh viên</label>
            <input value="@Model.MaSinhVien" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label"></label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MaKhoa" class="form-label"></label>
            <select asp-for="MaKhoa" asp-items="Model.DanhSachKhoa" class="form-select">
                <option value="">-- Chọn khoa --</option>
            </select>
            <span asp-validation-for="MaKhoa" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
