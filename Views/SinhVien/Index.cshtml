
@model IEnumerable<DemoMVC.Models.SinhVien>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm sinh viên
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Tuổi</th>
            <th>Khoa</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sv in Model)
        {
            <tr>
                <td>@sv.Id</td>
                <td>@sv.HoTen</td>
                <td>@sv.Email</td>
                <td>@sv.Tuoi</td>
                <td>@(sv.Khoa?.TenKhoa ?? "Chưa có khoa")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@sv.Id">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@sv.Id">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@sv.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
