@model IEnumerable<DemoMVC.Models.SinhVien>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container">
    <h1>Danh sách sinh viên</h1>

    @if (TempData["ThongBao"] is string thongBao)
    {
        <div class="alert alert-success" role="alert">@thongBao</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Mã sinh viên</th>
                    <th>Họ tên</th>
                    <th>Năm nhập học</th>
                    <th>Hệ</th>
                    <th>Mã ngành</th>
                    <th>Khoa</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var sinhVien in Model)
            {
                <tr>
                    <td>@sinhVien.MaSinhVien</td>
                    <td>@sinhVien.HoTen</td>
                    <td>@sinhVien.NamNhapHoc</td>
                    <td>@sinhVien.MaHeDaoTao</td>
                    <td>@sinhVien.MaNganh</td>
                    <td>@sinhVien.Khoa.TenKhoa</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@sinhVien.MaSinhVien">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@sinhVien.MaSinhVien">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@sinhVien.MaSinhVien">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
