
@model DemoMVC.Models.PagedResult<DemoMVC.Models.SinhVien>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
    }

    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@Model.SearchTerm"
               class="form-control" placeholder="Tìm sinh viên..." />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
    </form>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Tuổi</th>
            <th>Khoa</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sv in Model.Items)
        {
            <tr>
                <td>@sv.Id</td>
                <td>@sv.HoTen</td>
                <td>@sv.Email</td>
                <td>@sv.Tuoi</td>
                <td>@(sv.Khoa?.TenKhoa ?? "Chưa có khoa")</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Details" asp-route-id="@sv.Id">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@sv.Id">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@sv.Id">Xóa</a>
                    </td>
                }
                else
                {
                    <td><a asp-action="Details" asp-route-id="@sv.Id">Chi tiết</a></td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span>Hiển thị @Model.Items.Count trên tổng số @Model.TotalItems bản ghi</span>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize">Trước</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
