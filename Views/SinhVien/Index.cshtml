@model IEnumerable<DemoMVC.Models.SinhVien>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container">
    <h1>Danh sách sinh viên</h1>

    <div id="student-message" class="alert d-none" role="status"></div>

    <p>
        <button type="button"
                class="btn btn-primary"
                data-student-modal-url="@Url.Action("Create")"
                data-student-modal-title="Thêm sinh viên">
            Thêm sinh viên
        </button>
    </p>

    <div id="student-table" data-student-list-url="@Url.Action("DanhSach")">
        <partial name="_DanhSach" model="Model" />
    </div>
</div>

<div class="modal fade" id="student-modal" tabindex="-1" aria-labelledby="student-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="student-modal-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="student-modal-body">
                <div class="text-center py-4" role="status">Đang tải...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sinh-vien.js" asp-append-version="true"></script>
}
